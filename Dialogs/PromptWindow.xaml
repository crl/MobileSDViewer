<Window x:Class="MobileSDViewer.Dialogs.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Height="180" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" Background="{StaticResource BrushBg}"
        UseLayoutRounding="True">
    <Border Padding="20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Width="88" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="确定" Width="88" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{StaticResource BrushMuted}"/>
                <TextBox x:Name="InputBox"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
