<Window x:Class="MobileSDViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MobileSDViewer — Android 文件管理"
        Icon="Assets/app.ico"
        Height="800" Width="1280" MinHeight="560" MinWidth="960"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BrushBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushHeader}" Padding="18,14">
            <DockPanel>
                <Border x:Name="AccessModeBadge" DockPanel.Dock="Right" CornerRadius="11"
                        Background="#2A3646" Padding="10,4" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="AccessModeText" Foreground="#D5DEE8" FontSize="12"/>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MobileSDViewer" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="通过 ADB 浏览 Android 设备文件" Foreground="#8B97A8" FontSize="12" Margin="20,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurface}" Padding="10,3"
                BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="210" MinWidth="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="设备" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DeviceCombo" Grid.Column="1" DisplayMemberPath="DisplayName"
                          SelectionChanged="DeviceCombo_SelectionChanged"/>
                <Button Grid.Column="2" Click="RefreshDevices_Click" Margin="4,0,0,0" ToolTip="刷新设备">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GhostIcon}" Text="&#xE72C;"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="4" Text="ADB" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="AdbPathBox" Grid.Column="5" LostFocus="AdbPathBox_LostFocus"/>
                <TextBlock x:Name="AdbStatusText" Grid.Column="6" VerticalAlignment="Center"
                           Margin="6,0,6,0" FontSize="11"/>
                <Button Grid.Column="7" Content="浏览" Click="BrowseAdb_Click"/>
                <TextBlock Grid.Column="9" Text="无线" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ConnectHostBox" Grid.Column="10" ToolTip="无线调试 IP:端口"/>
                <Button Grid.Column="11" Content="连接" Style="{StaticResource AccentButton}"
                        Click="Connect_Click" Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurface}" Padding="16,10,16,12"
                BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1">
            <StackPanel>
                <WrapPanel Margin="0,0,0,10">
                    <Button Style="{StaticResource ChipButton}" Click="Shortcut_Click" Tag="/sdcard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GhostIcon}" Text="&#xE7F1;" Foreground="#1B7A4E"/>
                            <TextBlock Text="SD卡"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Click="Shortcut_Click" Tag="/sdcard/Download">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GhostIcon}" Text="&#xE896;" Foreground="#2563EB"/>
                            <TextBlock Text="Download"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Click="Shortcut_Click" Tag="/sdcard/DCIM">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GhostIcon}" Text="&#xE722;" Foreground="#7C3AED"/>
                            <TextBlock Text="DCIM"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Click="AndroidData_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GhostIcon}" Text="&#xE8F1;" Foreground="#0F766E"/>
                            <TextBlock Text="Android/data"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Click="GamePackage_Click"
                            ToolTip="com.shengqugames.shelterslg.debug">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GhostIcon}" Text="&#xE7FC;" Foreground="#C2410C"/>
                            <TextBlock Text="本游戏"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Click="InstallApk_Click" ToolTip="选择 APK 安装到当前设备">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GhostIcon}" Text="&#xE930;" Foreground="#1B7A4E"/>
                            <TextBlock Text="安装 APK"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Click="Parent_Click" ToolTip="上级目录" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GhostIcon}" Text="&#xE74A;"/>
                            <TextBlock Text="上级"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Left" Click="RefreshFolder_Click" ToolTip="刷新当前目录" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GhostIcon}" Text="&#xE72C;"/>
                            <TextBlock Text="刷新"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Left" Click="Upload_Click" ToolTip="上传文件到当前目录" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GhostIcon}" Text="&#xE898;" Foreground="#0F766E"/>
                            <TextBlock Text="上传"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Left" Click="ToolbarDownload_Click" ToolTip="下载选中项；未选中则下载当前文件夹" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GhostIcon}" Text="&#xE896;" Foreground="#2563EB"/>
                            <TextBlock Text="下载"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="转到" Style="{StaticResource AccentButton}" Click="GoPath_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="PathBox" KeyDown="PathBox_KeyDown"/>
                </DockPanel>
                <WrapPanel x:Name="BreadcrumbPanel" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" MinHeight="160"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*" MinHeight="72"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="160"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="300" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="目录" Style="{StaticResource PanelTitle}"/>
                    <TreeView x:Name="FolderTree"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              TreeViewItem.Expanded="FolderTree_Expanded">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}"
                                               Foreground="#D4A017" FontSize="14" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="4,10,4,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="文件" Style="{StaticResource PanelTitle}" Margin="8,0,0,6"/>
                    <ListView x:Name="FileList"
                              SelectionMode="Extended"
                              AllowDrop="True"
                              DragOver="FileList_DragOver"
                              Drop="FileList_Drop"
                              MouseDoubleClick="FileList_MouseDoubleClick"
                              SelectionChanged="FileList_SelectionChanged"
                              KeyDown="FileList_KeyDown">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="下载…" Click="Download_Click"/>
                                <MenuItem Header="上传到此目录…" Click="Upload_Click"/>
                                <Separator/>
                                <MenuItem Header="新建文件夹…" Click="Mkdir_Click"/>
                                <MenuItem Header="重命名…" Click="Rename_Click"/>
                                <MenuItem Header="删除" Click="Delete_Click"/>
                                <Separator/>
                                <MenuItem Header="复制路径" Click="CopyPath_Click"/>
                                <MenuItem Header="刷新" Click="RefreshFolder_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="280">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="FileIcon" FontFamily="{StaticResource IconFont}"
                                                           Text="&#xE8A5;" Foreground="#64748B" FontSize="15"
                                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                    <Setter TargetName="FileIcon" Property="Text" Value="&#xE8B7;"/>
                                                    <Setter TargetName="FileIcon" Property="Foreground" Value="#D4A017"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSymlink}" Value="True">
                                                    <Setter TargetName="FileIcon" Property="Text" Value="&#xE71B;"/>
                                                    <Setter TargetName="FileIcon" Property="Foreground" Value="#7C3AED"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="大小" Width="88" DisplayMemberBinding="{Binding DisplaySize}"/>
                                <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding DisplayTime}"/>
                                <GridViewColumn Header="类型" Width="72" DisplayMemberBinding="{Binding TypeLabel}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="4" Style="{StaticResource PanelCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="预览" Style="{StaticResource PanelTitle}"/>
                    <TextBox x:Name="PreviewMetaBox" Style="{StaticResource MetaTextBox}" DockPanel.Dock="Top" MinHeight="64" Margin="0,0,0,8"/>
                    <DockPanel x:Name="PreviewSearchBar" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="Collapsed">
                        <Button x:Name="PreviewSearchPrev" DockPanel.Dock="Right" Click="PreviewSearchPrev_Click"
                                ToolTip="上一个 (Shift+Enter)" MinWidth="32" Padding="8,4" Margin="0">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" FontSize="12"/>
                        </Button>
                        <Button x:Name="PreviewSearchNext" DockPanel.Dock="Right" Click="PreviewSearchNext_Click"
                                ToolTip="下一个 (Enter)" MinWidth="32" Padding="8,4" Margin="0,0,4,0">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="12"/>
                        </Button>
                        <TextBlock x:Name="PreviewSearchCount" DockPanel.Dock="Right" MinWidth="48"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{StaticResource BrushMuted}" FontSize="11" Margin="8,0,8,0"
                                   Text=""/>
                        <TextBox x:Name="PreviewSearchBox" MinHeight="28" FontSize="12"
                                 ToolTip="在预览中搜索（Ctrl+F）"
                                 TextChanged="PreviewSearchBox_TextChanged"
                                 KeyDown="PreviewSearchBox_KeyDown"/>
                    </DockPanel>
                    <Border Background="#F7F9FB" CornerRadius="8" Padding="8">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            <RichTextBox x:Name="PreviewTextBox" Style="{StaticResource PreviewRichTextBox}"
                                         Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource BrushLine}"
                    VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False"/>
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" Background="Transparent" Cursor="SizeNS"
                          ToolTip="拖动调整日志高度"/>

            <DockPanel Grid.Row="2">
                <ProgressBar x:Name="WorkProgress" DockPanel.Dock="Top" IsIndeterminate="False"/>
                <Border Background="{StaticResource BrushSurface}" Padding="16,8,16,12"
                        BorderBrush="{StaticResource BrushLine}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" FontSize="12"
                                   Foreground="{StaticResource BrushMuted}" Margin="0,0,0,8" Text="就绪"/>
                        <TextBox x:Name="LogBox" Style="{StaticResource ConsoleTextBox}"
                                 MinHeight="40" IsReadOnly="True"
                                 VerticalAlignment="Stretch"/>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
